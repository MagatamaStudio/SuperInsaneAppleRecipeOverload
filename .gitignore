# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.vscode/
.eclipse/

# OS
Thumbs.db
.DS_Store

# 本地离线插件仓库（第三方 jar，不入库；用 gradle/setup-offline-repo.ps1 重建）
# 注意用 /* 而不是整个目录：整个目录被忽略时，下面的 ! 例外不生效
gradle/offline-repo/*

# 本地研究资料（体积大，不纳入版本管理）
_research/
mc-assets/

# 生成物
run/
logs/
src/generated/resources/.cache/

# JEI 编译期依赖（插件编译需要，玩家侧可选）
!gradle/offline-repo/jei/
# AE2 全量 jar（视觉测试 harness 编译期需要 AE2 内部类，玩家侧可选）
!gradle/offline-repo/ae2/
